# Copy to .env (never commit .env). Values here are safe examples.
NODE_ENV=development
PORT=3001
DB_PATH=data/portal.db
UPLOAD_DIR=data/uploads
# At least 32 characters in production
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# 1 when behind exactly one reverse proxy; empty = trust none
TRUST_PROXY=
COOKIE_SECURE=false
# ISO time; defaults to FINAL_DEADLINE in src/data/tracks.js
DEADLINE=2027-01-15T23:59:00+07:00
MAX_PHOTO_KB=200
MAX_WORK_MB=50
MAX_VIDEO_MB=500
# 64 hex chars (plan B)
TOKEN_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google/callback
APP_ORIGIN=http://localhost:3000

# --- deploy (plan D) ---
# HOST is read by src/index.js only; 0.0.0.0 inside Docker
HOST=127.0.0.1
# true in production: the API also serves the built frontend (dist/)
SERVE_STATIC=false
STATIC_DIR=../dist
# where scripts/backup.js writes (relative to server/)
BACKUP_DIR=backups
